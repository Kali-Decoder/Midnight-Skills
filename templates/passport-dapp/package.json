{
  "name": "mn-passport-foundations-demo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Self-contained MN Passport foundations demo with passkey onboarding, identity registration, direct custody deposit, and restore flow.",
  "scripts": {
    "compile": "compact compile +0.36.1 contracts/account.compact contracts/managed/account && compact compile +0.36.1 contracts/faucet.compact contracts/managed/faucet && compact compile +0.36.1 contracts/identity_registry.compact contracts/managed/identity_registry",
    "build": "tsc",
    "demo": "node scripts/demo-local.mjs",
    "demo:e2e": "node app/scripts/e2e-devmode.mjs http://127.0.0.1:5173/",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "tsx src/tests/deploy.ts",
    "test:lifecycle": "tsx src/tests/lifecycle-night.ts",
    "test:shielded": "tsx src/tests/lifecycle-shielded.ts",
    "test:grants": "tsx src/tests/lifecycle-grants.ts",
    "test:recovery": "tsx src/tests/lifecycle-recovery.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.2",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/midnight-js-contracts": "5.0.2",
    "@midnightntwrk/midnight-js-http-client-proof-provider": "5.0.2",
    "@midnightntwrk/midnight-js-indexer-public-data-provider": "5.0.2",
    "@midnightntwrk/midnight-js-level-private-state-provider": "5.0.2",
    "@midnightntwrk/midnight-js-node-zk-config-provider": "5.0.2",
    "@midnightntwrk/midnight-js-types": "5.0.2",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.1",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.1.0",
    "@midnightntwrk/wallet-sdk-facade": "5.0.1",
    "@midnightntwrk/wallet-sdk-hd": "4.0.0",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.1",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.1",
    "bip39": "^3.1.0",
    "rxjs": "^7.8.2",
    "ws": "^8.19.0"
  }
}
