# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# Session signing (use a long random string)
SESSION_SECRET=

# MongoDB — set MONGODB_DB to your cluster database name
# If /api/users returns ok:false, open Atlas → Network Access → Add Current IP Address
MONGODB_URI=
MONGODB_DB=midskills

# Skills registry (optional overrides)
# REGISTRY_LOCAL_PATH=../midnight-skills-content
# Default source is registry-version.txt (local | v1.0.0 | main)
